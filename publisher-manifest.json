var(--slate-soft);margin:0 0 10px}\n  .client .addr{font-size:13px;color:var(--slate);border-top:1px dashed var(--line);padding-top:10px;margin:0}\n\n  /* 说明 */\n  .notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:28px 48px}\n  .notes article{border-top:2px solid var(--cyan);padding-top:16px}\n  .notes p{font-size:15px;color:var(--slate-soft);margin:0}\n\n  /* FAQ：编号列表 */\n  .faq{background:var(--white);border-top:1px solid var(--line)}\n  .faq-list{list-style:none;margin:0;padding:0;counter-reset:q;display:grid;gap:0}\n  .faq-list > li{counter-increment:q;display:grid;grid-template-columns:64px minmax(0,1fr);gap:20px;padding:26px 0;border-bottom:1px solid var(--line)}\n  .faq-list > li::before{content:counter(q,decimal-leading-zero);font-size:26px;font-weight:700;color:var(--cyan);line-height:1.2}\n  .faq-list h3{margin:0 0 8px;font-size:17px}\n  .faq-list p{margin:0;font-size:15px;color:var(--slate-soft)}\n  .faq-list p + p{margin-top:10px}\n\n  footer{background:var(--slate-deep);color:#b9c3cb;font-size:14px;padding:44px 0}\n  footer .wrap{display:grid;gap:18px}\n  footer a{color:#dfe6ea}\n  footer a:hover{color:#8fd3da}\n  footer .fine{color:#8b969f;font-size:13px;margin:0}\n\n  @media (max-width:860px){\n    .hero .wrap{grid-template-columns:1fr;gap:36px;padding-top:56px;padding-bottom:60px}\n    .hero-aside{border-left:none;border-top:1px solid var(--line);padding-left:0;padding-top:26px}\n    .plan{grid-template-columns:1fr;gap:16px}\n    .plan-side{text-align:left}\n    section{padding:56px 0}\n  }\n  @media (max-width:520px){\n    .wrap{padding:0 18px}\n    .btn{width:100%;text-align:center}\n    .faq-list > li{grid-template-columns:44px minmax(0,1fr);gap:12px}\n    .faq-list > li::before{font-size:20px}\n  }\n</style><nav class=\"breadcrumb\" aria-label=\"面包屑\">\n  <div class=\"wrap\">\n    <a href=\"#\">首页</a>\n    <span class=\"sep\">/</span>\n    <a href=\"#\">服务说明</a>\n    <span class=\"sep\">/</span>\n    <span class=\"here\">会员与使用</span>\n  </div>\n</nav>\n\n<nav class=\"toc\" aria-label=\"页内目录\">\n  <div class=\"wrap\">\n    <span class=\"label\">目录</span>\n    <a href=\"#start\">从哪里开始</a>\n    <a href=\"#plans\">会员计划</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#notes\">使用说明</a>\n    <a href=\"#faq\">常见问题</a>\n  </div>\n</nav>\n\n<main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-col\">\n        <span class=\"kicker\">新田园生活 · 服务说明</span>\n        <h1>新田园生活：先弄清怎么用，再决定选哪一档</h1>\n        <p class=\"lead\">这页不谈口号，只回答几个实际问题：会员计划各档差在哪里、客户端怎么拿、用之前需要准备什么、出问题找谁。你可以按顺序读，也可以直接跳到关心的那一段。</p>\n        <div class=\"hero-links\">\n          <a class=\"btn\" href=\"#plans\">看会员计划</a>\n          <a class=\"btn ghost\" href=\"#faq\">直接看常见问题</a>\n        </div>\n      </div>\n      <aside class=\"hero-aside\">\n        <dl>\n          <div>\n            <dt>本页回答什么</dt>\n            <dd>三档会员的价格与权益、客户端获取方式、使用前的准备，以及一组常见疑问。</dd>\n          </div>\n          <div>\n            <dt>怎么读更快</dt>\n            <dd>第一次来，先从“从哪里开始”看三步；已经决定好的，直接看会员计划的逐行对比。</dd>\n          </div>\n          <div>\n            <dt>信息边界</dt>\n            <dd>本页只记录已确认的内容。涉及具体线路、速度与承诺的部分，以实际获取到的说明为准。</dd>\n          </div>\n        </dl>\n      </aside>\n    </div>\n  </header>\n\n  <section id=\"start\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>从哪里开始？先把这三件事想清楚</h2>\n        <span class=\"note\">三步，按顺序来即可</span>\n      </div>\n      <ol class=\"steps\">\n        <li>\n          <h3>算清自己的用量</h3>\n          <p>你同时用几台设备、每个月大概跑多少流量？先估一个范围，再去看哪档够用。估不准就往上一档留余量，比事后补差价省事。</p>\n          <span class=\"num\">1</span>\n        </li>\n        <li>\n          <h3>确认客户端来源</h3>\n          <p>客户端只从本页列出的渠道获取。拿到后核对名称与版本，不要安装来源不明的同名片本。</p>\n          <span class=\"num\">2</span>\n        </li>\n        <li>\n          <h3>按说明完成设置</h3>\n          <p>安装、登录、选择配置，三步走完再开始使用。中途卡住，先翻本页“使用说明”，再看常见问题。</p>\n          <span class=\"num\">3</span>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>会员计划：三档逐行展开</h2>\n        <span class=\"note\">价格与权益按行列出，方便对照</span>\n      </div>\n      <div class=\"plans\">\n        <div class=\"plan\">\n          <div>\n            <p class=\"plan-name\">基础版</p>\n            <p class=\"plan-annual\">适合设备少、用量轻的个人使用</p>\n          </div>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>包含基础流媒体使用</li>\n            <li>使用普通线路节点池</li>\n          </ul>\n          <div class=\"plan-side\">\n            <p class=\"plan-price\">¥15<small>/月</small></p>\n            <p class=\"plan-annual\">按年付 ¥150/年</p>\n            <a class=\"pick\" href=\"#\">选择基础版</a>\n          </div>\n        </div>\n\n        <div class=\"plan featured\">\n          <div>\n            <p class=\"plan-name\">旗舰版</p>\n            <span class=\"plan-tag\">推荐</span>\n            <p class=\"plan-annual\">设备稍多、需要更好的线路与支持</p>\n          </div>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点流媒体原生解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <div class=\"plan-side\">\n            <p class=\"plan-price\">¥35<small>/月</small></p>\n            <p class=\"plan-annual\">按年付 ¥350/年</p>\n            <a class=\"pick\" href=\"#\">选择旗舰版</a>\n          </div>\n        </div>\n\n        <div class=\"plan\">\n          <div>\n            <p class=\"plan-name\">团队版</p>\n            <p class=\"plan-annual\">多人共用、需要统一管理与对接</p>\n          </div>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>配专属客户经理服务</li>\n          </ul>\n          <div class=\"plan-side\">\n            <p class=\"plan-price\">¥85<small>/月</small></p>\n            <p class=\"plan-annual\">按年付 ¥850/年</p>\n            <a class=\"pick\" href=\"#\">选择团队版</a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>客户端：按平台对号入座</h2>\n        <span class=\"note\">下载地址以实际提供的渠道为准</span>\n      </div>\n      <div class=\"clients\">\n        <div class=\"client\">\n          <h3>桌面端</h3>\n          <p>适合长时间在电脑前工作的场景。安装后登录账号，按提示选择配置即可开始使用。</p>\n          <p class=\"addr\">获取方式：请通过官方说明中列出的渠道下载，本页暂不提供直链。</p>\n          <span class=\"num\">01</span>\n        </div>\n        <div class=\"client\">\n          <h3>移动端</h3>\n          <p>适合随身使用。手机与电脑可同时在线，具体可同时在线数量取决于你所选的会员档位。</p>\n          <p class=\"addr\">获取方式：请通过官方说明中列出的渠道下载，本页暂不提供直链。</p>\n          <span class=\"num\">02</span>\n        </div>\n        <div class=\"client\">\n          <h3>其他平台</h3>\n          <p>若你的设备不属于以上两类，先确认该平台是否在支持范围内，再决定是否订阅。</p>\n          <p class=\"addr\">获取方式：以官方说明为准；不确定时可先查看常见问题中的相关条目。</p>\n          <span class=\"num\">03</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"notes\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>使用说明：几件容易忽略的事</h2>\n        <span class=\"note\">先看这几条，能少走弯路</span>\n      </div>\n      <div class=\"notes\">\n        <article>\n          <h3>关于同时在线</h3>\n          <p>三档分别对应 3、5、20 台设备同时在线。这里的数字指同一时间连着的设备数量，不是累计绑定数量；换设备前先退出旧设备，可以避免自己占满名额。</p>\n        </article>\n        <article>\n          <h3>关于流量额度</h3>\n          <p>额度按月计算，100GB、300GB、1000GB 各自独立。视频与下载通常最耗流量，如果你常看高清内容，选档时把这一项权重调高一些。</p>\n        </article>\n        <article>\n          <h3>关于线路差异</h3>\n          <p>基础版用普通线路节点池，旗舰版包含 IPLC 专线与游戏加速优化，团队版提供 VIP 高带宽节点。线路表现与实际网络环境相关，本页不做速度承诺。</p>\n        </article>\n        <article>\n          <h3>关于支持渠道</h3>\n          <p>旗舰版含 7×24 优先工单支持，团队版配专属客户经理。基础版用户可通过常规工单反馈问题；提交时附上平台与现象描述，处理会更快。</p>\n        </article>\n        <article>\n          <h3>关于升级与调整</h3>\n          <p>用量接近上限或设备不够时，可从低档换到高档。具体调整方式与生效时间，请以实际购买页面或客服确认为准，本页不代为承诺。</p>\n        </article>\n        <article>\n          <h3>关于年付</h3>\n          <p>年付价格分别为 ¥150、¥350、¥850。年付适合确定会长期使用的场景；如果你还在试用阶段，先按月付观察一段时间更稳妥。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>常见问题</h2>\n        <span class=\"note\">按顺序编号，逐条回答</span>\n      </div>\n      <ol class=\"faq-list\">\n        <li>\n          <div>\n            <h3>我该从哪一档开始？</h3>\n            <p>先看你同时用几台设备。三台以内、用量不大，基础版通常够用；如果你经常在手机和电脑之间切换，或者会用流媒体和游戏，旗舰版更从容；多人共用、需要统一管理，再考虑团队版。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>按月付还是按年付更合适？</h3>\n            <p>不确定会长期使用时，先按月付，观察一个月再做决定。确定会持续使用，年付更省：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>客户端从哪里获取？</h3>\n            <p>请通过官方说明中列出的渠道获取。本页不提供下载直链，也不建议使用第三方来源的同名安装包。安装前核对名称与版本，来源不明的包直接跳过。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>同时在线数量是怎么算的？</h3>\n            <p>指同一时间内保持连接的设备数。基础版 3 台、旗舰版 5 台、团队版 20 台。如果提示名额已满，先检查是否有旧设备仍在登录状态。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>流量用完了会怎样？</h3>\n            <p>额度按月计算，用尽后当月剩余时间的使用会受限。你可以等到下个周期重置，或按页面提示调整到更高一档。具体规则请以购买页面与实际说明为准。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>遇到问题找谁？</h3>\n            <p>旗舰版用户走 7×24 优先工单；团队版有专属客户经理对接；基础版用户可通过常规工单反馈。提交问题时写清平台、操作步骤和现象，能明显缩短来回确认的时间。</p>\n          </div>\n        </li>\n        <li>\n          <div>\n            <h3>本页为什么不写速度和节点数量？</h3>\n            <p>因为这类数据会随线路与网络环境变化，写死在页面上容易误导。本页只说明各档包含哪些权益，实际表现请以你获取到的官方说明和自身使用情况为准。</p>\n          </div>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div>\n      <a href=\"#start\">从哪里开始</a> ·\n      <a href=\"#plans\">会员计划</a> ·\n      <a href=\"#clients\">客户端</a> ·\n      <a href=\"#notes\">使用说明</a> ·\n      <a href=\"#faq\">常见问题</a>\n    </div>\n    <p class=\"fine\">新田园生活 · 本页内容为服务与会员计划的说明性文字，价格与权益以购买页面展示为准。</p>\n  </div>\n</footer>",
